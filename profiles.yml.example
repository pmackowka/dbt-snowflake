# Szablon połączenia ze Snowflake.
# Skopiuj do profiles.yml (plik jest w .gitignore) albo do ~/.dbt/profiles.yml.
#
# Key-pair auth, nie hasło: standard Snowflake dla kont serwisowych (TYPE=SERVICE). Klucz nie
# wygasa jak sesja i działa też w CI. To rola z profilu, a nie dbt, rozstrzyga, co dbt może
# zbudować - dbt robi w Snowflake dokładnie to, na co GRANT-y pozwalają tej roli.
# Generowanie klucza i provisioning -> README.md -> Setup -> 1. Snowflake.
#
# Wymagane zmienne środowiskowe :
#   export SNOWFLAKE_ACCOUNT="xy12345.us-east-2.aws"
#   export SNOWFLAKE_USER="dbt"
#   export SNOWFLAKE_PRIVATE_KEY_PATH="/sciezka/do/klucza/rsa_key.p8"   # POZA folderem repo
#   export SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=""                          # puste, jeśli klucz bez hasła
snowflake_project: # musi pasować do `profile:` w dbt_project.yml
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      role: TRANSFORM
      database: AIRBNB
      warehouse: COMPUTE_WH
      schema: DEV
      # Wątki dzielą JEDEN warehouse: Snowflake wykonuje na nim naraz do MAX_CONCURRENCY_LEVEL
      # zapytań (domyślnie 8), resztę kolejkuje. Płaci się za czas działania warehouse'u, nie za
      # zapytanie, więc równoległe małe modele skracają ten czas. Najszerszy poziom DAG-u to ok. 5
      # węzłów (seed, 2 snapshoty, 2 dim, fct) - 4 wystarcza, 1 serializował wszystko.
      threads: 4
      # Tag trafia do QUERY_HISTORY: po nim filtruje się koszt dbt per środowisko.
      query_tag: dbt_snowflake_project_dev

