# Szablon połączenia ze Snowflake.
# Skopiuj do profiles.yml (plik jest w .gitignore) albo do ~/.dbt/profiles.yml.
#
# Key-pair auth, nie hasło: standard Snowflake dla kont serwisowych (TYPE=SERVICE), działa też w CI.
# Co dbt może zbudować, rozstrzyga rola z profilu, nie dbt - dbt robi to, na co pozwalają jej GRANT-y.
# Klucz i provisioning -> README.md -> Setup -> 1. Snowflake.
#
# Wymagane zmienne środowiskowe (dev - domyślny target):
#   export SNOWFLAKE_ACCOUNT="xy12345.us-east-2.aws"
#   export SNOWFLAKE_USER="dbt"
#   export SNOWFLAKE_PRIVATE_KEY_PATH="/sciezka/do/klucza/rsa_key.p8"   # POZA folderem repo
#   export SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=""                          # puste, jeśli klucz bez hasła
# Tylko przy --target prod (osobna tożsamość, patrz komentarz przy targecie prod):
#   export SNOWFLAKE_PROD_ACCOUNT, SNOWFLAKE_PROD_USER, SNOWFLAKE_PROD_PRIVATE_KEY_PATH
#   (opcjonalnie SNOWFLAKE_PROD_PRIVATE_KEY_PASSPHRASE)
snowflake_project: # musi pasować do `profile:` w dbt_project.yml
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      role: TRANSFORM
      database: AIRBNB
      warehouse: COMPUTE_WH
      schema: DEV
      # Wątki dzielą JEDEN warehouse: naraz do MAX_CONCURRENCY_LEVEL zapytań (domyślnie 8), reszta
      # w kolejce. Płaci się za czas działania warehouse'u, więc równoległość małych modeli go
      # skraca. Najszerszy poziom DAG-u to ok. 5 węzłów - 4 wystarcza.
      threads: 4
      # Tag trafia do QUERY_HISTORY: po nim filtruje się koszt dbt per środowisko.
      query_tag: dbt_snowflake_project_dev

    # Prod ma WŁASNE zmienne, bez fallbacku na dev: przy wspólnym userze przypadkowe --target prod
    # z laptopa = zapis do prod, a QUERY_HISTORY nie odróżni środowisk. dbt renderuje tylko
    # wybrany target, więc dev działa bez zmiennych prod. TRANSFORM_PROD -> README, Setup.
    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_PROD_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_PROD_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PROD_PRIVATE_KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PROD_PRIVATE_KEY_PASSPHRASE', '') }}"
      role: TRANSFORM_PROD
      database: AIRBNB
      warehouse: COMPUTE_WH
      schema: PROD
      threads: 4  # uzasadnienie przy targecie dev
      query_tag: dbt_snowflake_project_prod
